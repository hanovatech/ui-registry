{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "phone-input",
	"title": "Phone Input",
	"type": "registry:ui",
	"description": "A telephone input with phone icon and required validation state (min. 6 digits).",
	"dependencies": [
		"@lucide/svelte"
	],
	"devDependencies": [
		"@lucide/svelte@^1.17.0"
	],
	"registryDependencies": [
		"input",
		"./input-label.json"
	],
	"files": [
		{
			"content": "<script lang=\"ts\">\n  import Input from '$lib/components/ui/input/input.svelte';\n  import PhoneIcon from '@lucide/svelte/icons/phone';\n  import { InputLabel } from '$lib/components/registry/input-label/index.js';\n\n  interface Props {\n    value?: string;\n    placeholder?: string;\n    disabled?: boolean;\n    required?: boolean;\n    label?: string;\n    hint?: string;\n    id?: string;\n    class?: string;\n  }\n\n  let {\n    value = $bindable(''),\n    placeholder = '+49 123 456789',\n    disabled = false,\n    required = false,\n    label = '',\n    hint = '',\n    id = crypto.randomUUID(),\n    class: className = 'bg-background',\n  }: Props = $props();\n\n  // Valid when at least 6 digits are present\n  const isValid = $derived((value.match(/\\d/g) ?? []).length >= 6);\n\n  function handleInput(e: Event & { currentTarget: HTMLInputElement }) {\n    // Allow only: digits, spaces, +, -, (, ), /\n    e.currentTarget.value = e.currentTarget.value.replace(/[^0-9\\s+\\-()\\/]/g, '');\n    value = e.currentTarget.value;\n  }\n</script>\n\n<InputLabel {label} {required} valid={isValid} for={id} {hint}>\n  <div class=\"relative\">\n    <span class=\"pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5 text-muted-foreground\">\n      <PhoneIcon class=\"size-4\" />\n    </span>\n    <Input\n      {id}\n      type=\"tel\"\n      inputmode=\"tel\"\n      {placeholder}\n      {value}\n      {disabled}\n      {required}\n      class=\"pl-9 {className}\"\n      oninput={handleInput}\n    />\n  </div>\n</InputLabel>\n",
			"type": "registry:component",
			"target": "registry/phone-input/phone-input.svelte"
		}
	]
}
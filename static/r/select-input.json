{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "select-input",
	"title": "Select Input",
	"type": "registry:ui",
	"description": "A form select built on shadcn-svelte Select with label and required validation state.",
	"dependencies": [
		"@lucide/svelte"
	],
	"devDependencies": [
		"@lucide/svelte@^1.17.0"
	],
	"registryDependencies": [
		"select"
	],
	"files": [
		{
			"content": "<script lang=\"ts\">\n  import * as Select from '$lib/components/ui/select/index.js';\n  import CircleDashed from '@lucide/svelte/icons/circle-dashed';\n  import CircleCheck from '@lucide/svelte/icons/circle-check';\n\n  interface Option {\n    value: string;\n    label: string;\n  }\n\n  interface Props {\n    /** Bound selected value, or `''` for no selection. */\n    value?: string;\n    options: Option[];\n    placeholder?: string;\n    disabled?: boolean;\n    required?: boolean;\n    label?: string;\n    id?: string;\n    class?: string;\n  }\n\n  let {\n    value = $bindable(''),\n    options,\n    placeholder = 'Auswählen…',\n    disabled = false,\n    required = false,\n    label = '',\n    id = crypto.randomUUID(),\n    class: className = 'w-full bg-background',\n  }: Props = $props();\n\n  const selectedLabel = $derived(options.find((o) => o.value === value)?.label ?? placeholder);\n</script>\n\n{#if label}\n  <div class=\"flex flex-col gap-1.5\">\n    <label for={id} class=\"flex items-center gap-1 text-xs font-medium text-foreground/75 leading-none\">\n      {label}\n      {#if required}\n        {#if value}\n          <CircleCheck class=\"size-3 text-green-500\" />\n        {:else}\n          <CircleDashed class=\"size-3 text-destructive\" />\n        {/if}\n      {/if}\n    </label>\n    {@render field()}\n  </div>\n{:else}\n  {@render field()}\n{/if}\n\n{#snippet field()}\n  <Select.Root type=\"single\" {value} onValueChange={(v) => (value = v)} {disabled}>\n    <Select.Trigger id={id} class={className}>\n      <span data-slot=\"select-value\" class={value ? '' : 'text-muted-foreground'}>\n        {selectedLabel}\n      </span>\n    </Select.Trigger>\n    <Select.Content>\n      {#each options as option (option.value)}\n        <Select.Item value={option.value} label={option.label}>{option.label}</Select.Item>\n      {/each}\n    </Select.Content>\n  </Select.Root>\n{/snippet}\n",
			"type": "registry:component",
			"target": "registry/select-input/select-input.svelte"
		}
	]
}
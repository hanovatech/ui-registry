{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "input-label",
	"title": "Input Label",
	"type": "registry:ui",
	"description": "A form label wrapper with optional description and required validation indicator.",
	"dependencies": [
		"@lucide/svelte"
	],
	"devDependencies": [
		"@lucide/svelte@^1.17.0"
	],
	"files": [
		{
			"content": "<script lang=\"ts\">\n  import type { Snippet } from 'svelte';\n  import CircleDashed from '@lucide/svelte/icons/circle-dashed';\n  import CircleCheck from '@lucide/svelte/icons/circle-check';\n  import { t } from '$lib/stores/i18n';\n\n  interface Props {\n    for?: string;\n    label?: string;\n    required?: boolean;\n    /** `null` = not yet validated (shows neutral `*`), `true` = valid, `false` = invalid */\n    valid?: boolean | null;\n    hint?: string;\n    class?: string;\n    labelClass?: string;\n    /** Optional snippet rendered to the right of the label row (e.g. a character counter). */\n    labelSuffix?: Snippet;\n    children?: Snippet;\n  }\n\n  let {\n    for: inputFor = undefined,\n    label = '',\n    required = false,\n    valid = null,\n    hint = '',\n    class: className = '',\n    labelClass = '',\n    labelSuffix,\n    children,\n  }: Props = $props();\n</script>\n\n<div class={`flex flex-col gap-1.5 ${className}`.trim()}>\n  {#if label}\n    <div class=\"flex flex-col gap-1\">\n      <div class={`flex items-center text-xs font-medium text-foreground/75 leading-none ${labelSuffix ? 'justify-between' : 'gap-1'}`.trim()}>\n        <div class=\"flex items-center gap-1\">\n          <label for={inputFor} class={`text-inherit ${labelClass}`.trim()}>{label}</label>\n          {#if required}\n            {#if valid === null}\n              <span class=\"text-muted-foreground\" aria-label={$t.common.required}>*</span>\n            {:else if valid}\n              <CircleCheck class=\"size-3 text-green-500\" aria-hidden=\"true\" />\n            {:else}\n              <CircleDashed class=\"size-3 text-destructive\" aria-hidden=\"true\" />\n            {/if}\n          {/if}\n        </div>\n        {#if labelSuffix}\n          {@render labelSuffix()}\n        {/if}\n      </div>\n    </div>\n  {/if}\n\n  {@render children?.()}\n\n  {#if hint}\n    <p class=\"text-xs text-muted-foreground leading-snug\">{hint}</p>\n  {/if}\n</div>\n",
			"type": "registry:component",
			"target": "registry/input-label/input-label.svelte"
		},
		{
			"content": "export { default as InputLabel } from './input-label.svelte';\n",
			"type": "registry:component",
			"target": "registry/input-label/index.ts"
		}
	]
}
{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "url-input",
	"title": "URL Input",
	"type": "registry:ui",
	"description": "A URL input with globe icon and required validation state (must be a valid http/https URL).",
	"dependencies": [
		"@lucide/svelte"
	],
	"devDependencies": [
		"@lucide/svelte@^1.17.0"
	],
	"registryDependencies": [
		"input",
		"./input-label.json"
	],
	"files": [
		{
			"content": "<script lang=\"ts\">\n  import Input from '$lib/components/ui/input/input.svelte';\n  import GlobeIcon from '@lucide/svelte/icons/globe';\n  import { InputLabel } from '$lib/components/registry/input-label/index.js';\n\n  interface Props {\n    value?: string;\n    placeholder?: string;\n    disabled?: boolean;\n    required?: boolean;\n    label?: string;\n    hint?: string;\n    id?: string;\n    class?: string;\n  }\n\n  let {\n    value = $bindable(''),\n    placeholder = 'https://example.com',\n    disabled = false,\n    required = false,\n    label = '',\n    hint = '',\n    id = crypto.randomUUID(),\n    class: className = 'bg-background',\n  }: Props = $props();\n\n  const isValid = $derived(/^https?:\\/\\/.+\\..+/.test(value));\n</script>\n\n<InputLabel {label} {required} valid={isValid} for={id} {hint}>\n  <div class=\"relative\">\n    <span class=\"pointer-events-none absolute inset-y-0 left-0 flex items-center pl-2.5 text-muted-foreground\">\n      <GlobeIcon class=\"size-4\" />\n    </span>\n    <Input\n      {id}\n      type=\"url\"\n      inputmode=\"url\"\n      {placeholder}\n      bind:value\n      {disabled}\n      {required}\n      class=\"pl-9 {className}\"\n    />\n  </div>\n</InputLabel>\n",
			"type": "registry:component",
			"target": "registry/url-input/url-input.svelte"
		}
	]
}
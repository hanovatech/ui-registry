{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "select-filter",
	"title": "Select Filter",
	"type": "registry:block",
	"description": "A select dropdown that syncs its value to URL search params.",
	"registryDependencies": [
		"select"
	],
	"files": [
		{
			"content": "<script lang=\"ts\">\n  import { goto } from '$app/navigation';\n  import { page } from '$app/state';\n  import { SvelteURLSearchParams } from 'svelte/reactivity';\n  import * as Select from '$lib/components/ui/select/index.js';\n\n  interface Props {\n    key: string;\n    defaultValue?: string;\n    placeholder?: string;\n    label?: string;\n    options: Array<{ value: string; label: string; }>;\n    class?: string;\n  }\n\n  let { key, options, defaultValue = '', placeholder = '', label = '', class: className = 'w-[220px] bg-background' }: Props = $props();\n\n  const currentValue = $derived(page.url.searchParams.get(key) || defaultValue);\n  const currentLabel = $derived(() => {\n    const option = options.find(o => o.value === currentValue);\n    return option?.label || placeholder;\n  });\n\n  function handleValueChange(value: string) {\n    const params = new SvelteURLSearchParams(page.url.searchParams);\n    params.delete('page');\n    if (value) { params.set(key, value); } else { params.delete(key); }\n    gotoParams(params);\n  }\n\n  function gotoParams(params: URLSearchParams) {\n    goto(`${page.url.pathname}?${params.toString()}`);\n  }\n</script>\n\n{#if label}\n  <div class=\"flex flex-col gap-1.5\">\n    <span class=\"text-xs font-medium text-foreground/75 leading-none\">{label}</span>\n    {@render select()}\n  </div>\n{:else}\n  {@render select()}\n{/if}\n\n{#snippet select()}\n  <Select.Root type=\"single\" value={currentValue} onValueChange={handleValueChange}>\n    <Select.Trigger class={className}>\n      <span data-slot=\"select-value\">{currentLabel()}</span>\n    </Select.Trigger>\n    <Select.Content>\n      {#each options as option (option.value)}\n        <Select.Item value={option.value} label={option.label}>{option.label}</Select.Item>\n      {/each}\n    </Select.Content>\n  </Select.Root>\n{/snippet}\n",
			"type": "registry:component",
			"target": "registry/select-filter/select-filter.svelte"
		}
	]
}